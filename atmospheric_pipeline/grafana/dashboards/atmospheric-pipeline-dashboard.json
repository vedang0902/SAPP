{
  "title": "Atmospheric Pipeline Monitoring",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "pipeline",
    "atmospheric",
    "prometheus"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pipeline Runs",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "atmospheric_pipeline_runs_created"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latest Records Processed",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "atmospheric_pipeline_records_total"
        }
      ]
    },
    {
      "id": 4,
      "title": "New Records Last Run",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "atmospheric_pipeline_new_records_last_run"
        }
      ]
    },
    {
      "id": 5,
      "title": "Anomalies Detected",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "atmospheric_pipeline_anomalies"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Pipeline Runs/sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(atmospheric_pipeline_runs_total[5m])"
        }
      ]
    },
    {
      "id": 7,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])"
        }
      ]
    },
    {
      "id": 8,
      "title": "Resident Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes"
        }
      ]
    },
    {
      "id": 9,
      "title": "Virtual Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "process_virtual_memory_bytes"
        }
      ]
    },
    {
      "id": 10,
      "title": "Open File Descriptors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "process_open_fds"
        }
      ]
    },
    {
      "id": 11,
      "title": "Max File Descriptors",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "expr": "process_max_fds"
        }
      ]
    },
    {
      "id": 12,
      "title": "GC Collections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(python_gc_collections_total[5m])"
        }
      ]
    },
    {
      "id": 13,
      "title": "GC Objects Collected",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "rate(python_gc_objects_collected_total[5m])"
        }
      ]
    },
    {
      "id": 14,
      "title": "GC Uncollectable Objects",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "rate(python_gc_objects_uncollectable_total[5m])"
        }
      ]
    },
    {
      "id": 15,
      "title": "Scrape Duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "scrape_duration_seconds"
        }
      ]
    },
    {
      "id": 16,
      "title": "Samples Scraped",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "targets": [
        {
          "expr": "scrape_samples_scraped"
        }
      ]
    },
    {
      "id": 17,
      "title": "Series Added",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "targets": [
        {
          "expr": "scrape_series_added"
        }
      ]
    }
  ]
}